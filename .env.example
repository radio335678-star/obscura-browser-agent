# ==============================================================================
# QUAASX ECOSYSTEM OBSCURA BROWSER ORCHESTRATOR — REFERENCE TEMPLATE (.env.example)
# ==============================================================================

# Obscura Engine Binaries
OBSCURA_BIN="path/to/obscura.exe"
OBSCURA_WORKER_BIN="path/to/obscura-worker.exe"

# Engine Mode & Stealth Settings
OBSCURA_STEALTH=true
OBSCURA_ALLOW_PRIVATE_NETWORK=true
OBSCURA_ROBOTS_TXT=false

# Chrome DevTools Protocol (CDP) Server
OBSCURA_CDP_HOST="127.0.0.1"
OBSCURA_CDP_PORT=9222
OBSCURA_CDP_WS_URL="ws://127.0.0.1:9222"
